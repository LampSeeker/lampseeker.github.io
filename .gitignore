# Dependencies / build artifacts
node_modules/
dist/
public/
resources/
.hugo_build.lock

# Environment files
.env
.env.local
.env.*.local

# OS / local temp files
.DS_Store

# Local Hugo server logs
.hugo-server*.log
.hugo-server*.err

# Notion sync generated content/assets
# Every synced page is a .md under content/; hand-written section files are _index.md.
content/**/*.md
!content/**/_index.md
static/notion-assets/**
data/notion_root_databases.json
